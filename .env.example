# ─────────────────────────────────────────────
# Inspire Space Digital Platform — Environment Variables
# Copy this file to .env and fill in values
# ─────────────────────────────────────────────

# ── Database ──────────────────────────────────
DATABASE_URL="postgresql://astro:astro@localhost:5432/astro_db"

# ── Auth.js ───────────────────────────────────
AUTH_SECRET="your-auth-secret-min-32-chars"
AUTH_URL="http://localhost:3000"

# ── Cloudflare R2 ─────────────────────────────
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="inspire-space-platform"
R2_PUBLIC_URL="https://your-r2-public-domain.com"

# ── Resend (Email) ────────────────────────────
RESEND_API_KEY="re_your_resend_api_key"
RESEND_FROM_EMAIL="noreply@inspirespacesl.org"
ADMIN_EMAIL="admin@inspirespacesl.org"

# ── App URLs ──────────────────────────────────
NEXT_PUBLIC_WEBSITE_URL="http://localhost:3000"
NEXT_PUBLIC_LEARNING_URL="http://localhost:3001"

# ── Super Admin Seed ──────────────────────────
SEED_ADMIN_EMAIL="admin@inspirespacesl.org"
SEED_ADMIN_PASSWORD="ChangeMe@2025!"
SEED_ADMIN_NAME="Platform Admin"
